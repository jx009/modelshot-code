{
  "name": "modelshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "description": "AI fashion model photography studio for e-commerce sellers",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "node src/workers/main.mjs",
    "ops": "node scripts/ops.mjs",
    "test:recovery": "node scripts/recovery-drill.mjs",
    "test:capacity": "node scripts/capacity-baseline.mjs",
    "lint": "eslint",
    "check:design": "python scripts/design-check.py",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:static": "npm run lint && npm run check:design && npm run check:i18n",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "setup:local": "node scripts/setup-local.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "pretest:acceptance": "prisma generate",
    "test:acceptance": "npm run check:static && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "zod": "4.6.1",
    "ipaddr.js": "2.5.0",
    "@google/generative-ai": "^0.24.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "prisma": "7.10.0",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "dotenv": "17.4.2",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "framer-motion": "^13.2.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.3",
    "openai": "^7.10.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.6.0",
    "sharp": "^0.35.4",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "26.1.0",
    "tailwindcss": "^4",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "c2pa-node": "0.5.26"
  },
  "overrides": {
    "next-auth": { "nodemailer": "$nodemailer" },
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "mysql2": "3.24.4",
    "sharp": "$sharp"
  }
}
