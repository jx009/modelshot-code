# Local services: npm run infra:up. Credentials are for loopback use only.
DATABASE_URL="postgresql://modelshot:local-modelshot-only@127.0.0.1:55432/modelshot"
DIRECT_URL="postgresql://modelshot:local-modelshot-only@127.0.0.1:55432/modelshot"
REDIS_URL="redis://127.0.0.1:56379/0"

# NextAuth Settings
NEXTAUTH_URL="http://127.0.0.1:3000"
# Generate each secret independently with crypto.randomBytes(32).toString('hex').
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""

SMTP_HOST="127.0.0.1"
SMTP_PORT="51025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ModelShot <noreply@modelshot.local>"

# Private storage; create the bucket with setup:local before starting the worker.
S3_ENDPOINT="http://127.0.0.1:59000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="modelshot-local"
S3_SECRET_ACCESS_KEY="local-modelshot-storage-only"
S3_BUCKET="modelshot-assets"

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_LOGIN_ENABLED="true"
# Only awarded once when a new email or OAuth account is created.
REGISTRATION_CREDITS="0"

# Optional providers. Local baseline tests never call these services.
OPENAI_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
FASHN_API_KEY=""

# Stripe Payments Configuration
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional signing requires native support and your own certificate.
C2PA_ENABLED="0"
C2PA_CERT_PATH=""
C2PA_KEY_PATH=""

PAYMENTS_ENABLED="0"
# Optional: configure these instead in Admin > Recharge & payments.
EPAY_ENABLED="0"
EPAY_GATEWAY=""
EPAY_MERCHANT_ID=""
EPAY_MERCHANT_KEY=""
EPAY_METHODS="alipay,wxpay"
PAYMENT_PUBLIC_URL=""
# Fixed credit packs are managed in the admin UI; no subscription or expiry.
QA_ENABLED="0"
WORKER_CONCURRENCY="4"
IMAGE_GENERATION_CONCURRENCY="128"
IMAGE_TRANSFER_CONCURRENCY="8"
IMAGE_PROCESSING_CONCURRENCY="4"
ENCRYPTION_KEY_VERSION="1"
# Retain ENCRYPTION_KEY_<old version> until ops rotate-keys has completed.
VERIFICATION_KEY_VERSION="1"
TRUST_PROXY="false"
# Isolated creation website preview/publication origin. Keep app cookies off
# this origin and proxy only /api/creation-preview and /api/public-sites/*.
# See docs/creation-web-runtime-publication.md. Empty disables interactive preview.
CREATION_PUBLICATION_ORIGIN=""
# ROOT configures HTTP/HTTPS model gateways in admin; no proxy-host allowlist is required.

# Enable after upgrading both creation workers (versioned Agent heartbeats).
CREATION_AGENT_ENABLED=false

# Editable PPTX import requires the matching isolated creation-export worker.
# See docs/creation-pptx-import-2026-10-28.md; no worker is started by this flag.
CREATION_OFFICE_IMPORT_ENABLED=false

# Video module access: saved administrator switches override these defaults.
# ROOT can enter closed modules; rendering still needs healthy infrastructure.
CREATION_VIDEO_ENABLED=false
CREATION_MOTION_ENABLED=false
# Existing Ark video adapter (text-to-video and optional first-frame image).
ARK_API_KEY=""
ARK_VIDEO_MODEL=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# Motion MP4 export requires the updated tools image with FFmpeg and CJK fonts.
# See docs/video-workspace-2026-10-28.md.
