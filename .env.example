# Local services: npm run infra:up. Credentials are for loopback use only.
DATABASE_URL="postgresql://modelshot:local-modelshot-only@127.0.0.1:55432/modelshot"
DIRECT_URL="postgresql://modelshot:local-modelshot-only@127.0.0.1:55432/modelshot"
REDIS_URL="redis://127.0.0.1:56379/0"

# NextAuth Settings
NEXTAUTH_URL="http://127.0.0.1:3000"
# Generate each secret independently with crypto.randomBytes(32).toString('hex').
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""

SMTP_HOST="127.0.0.1"
SMTP_PORT="51025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ModelShot <noreply@modelshot.local>"

# Private storage; create the bucket with setup:local before starting the worker.
S3_ENDPOINT="http://127.0.0.1:59000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="modelshot-local"
S3_SECRET_ACCESS_KEY="local-modelshot-storage-only"
S3_BUCKET="modelshot-assets"

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional providers. Local baseline tests never call these services.
OPENAI_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
FASHN_API_KEY=""

# Stripe Payments Configuration
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional signing requires native support and your own certificate.
C2PA_ENABLED="0"
C2PA_CERT_PATH=""
C2PA_KEY_PATH=""

PAYMENTS_ENABLED="0"
QA_ENABLED="0"
WORKER_CONCURRENCY="2"
ENCRYPTION_KEY_VERSION="1"
# Retain ENCRYPTION_KEY_<old version> until ops rotate-keys has completed.
VERIFICATION_KEY_VERSION="1"
TRUST_PROXY="false"
# Comma-separated approved HTTPS proxy hostnames for platform provider credentials.
PROVIDER_PROXY_HOSTS=""
