{
  "name": "modelshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "description": "AI commerce visual production studio for product galleries, detail pages and campaigns",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "node src/workers/main.mjs",
    "worker:creation": "node src/workers/creation-main.mjs",
    "worker:creation-language": "node src/workers/creation-language-main.mjs",
    "worker:creation-export": "node src/workers/creation-export-main.mjs",
    "ops": "node scripts/ops.mjs",
    "test:recovery": "node scripts/recovery-drill.mjs",
    "test:capacity": "node scripts/capacity-baseline.mjs",
    "lint": "eslint",
    "check:design": "python scripts/design-check.py",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:static": "npm run lint && npm run check:design && npm run check:i18n && npm run check:demo-assets",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "seed:demo": "node scripts/seed-demo-assets.mjs",
    "check:demo-assets": "node scripts/seed-demo-assets.mjs --verify-only",
    "generate:demo-models": "node scripts/generate-demo-models.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.mjs",
    "pretest:acceptance": "prisma generate",
    "test:acceptance": "npm run check:static && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e",
    "studio:tools": "node scripts/studio-tools.mjs",
    "studio:dev": "node scripts/studio-dev.mjs",
    "test:studio-tools": "node scripts/smoke-studio-tools.mjs",
    "build:thumbs": "node scripts/build-inspiration-thumbs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@google/generative-ai": "^0.24.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@noble/hashes": "2.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ag-psd": "29.0.0",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dotenv": "17.4.2",
    "ioredis": "^6.0.0",
    "ipaddr.js": "2.5.0",
    "jszip": "^3.10.2",
    "konva": "10.7.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.3",
    "openai": "^7.10.0",
    "parse5": "^7.3.0",
    "pg": "^8.21.0",
    "prisma": "7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-konva": "19.2.3",
    "saxes": "6.0.0",
    "sharp": "^0.35.4",
    "stripe": "^22.1.1",
    "undici": "7.30.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "26.1.0",
    "tailwindcss": "^4",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "c2pa-node": "0.5.26"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.4",
    "sharp": "$sharp"
  }
}
