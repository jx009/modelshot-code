# ModelShot 生产环境变量模板
# 复制为 .env.production 后逐项填写：cp .env.production.example .env.production
#
# 这个文件有两个用途，所以启动命令必须带 --env-file：
#   1. Compose 用它做 ${VAR} 变量替换（生成 DATABASE_URL、容器端口等）；
#   2. 通过 env_file 注入 Web / Worker / migrate 容器。
#
# DATABASE_URL、DIRECT_URL、REDIS_URL、S3_ENDPOINT、S3_ACCESS_KEY_ID、S3_SECRET_ACCESS_KEY
# 不在这里填写：它们由下面的 POSTGRES_* / STORAGE_* 在 compose.prod.yaml 里统一推导，
# 避免数据库密码、存储密钥写两处导致对不上。

# ============ 数据库（同时用于推导应用连接串）============
# 密码会拼进连接串，只允许字母数字，用 hex 最稳：
#   openssl rand -hex 24
POSTGRES_USER=modelshot
POSTGRES_PASSWORD=请替换为openssl-rand-hex-24
POSTGRES_DB=modelshot

# ============ 私有对象存储（MinIO）============
# 同样会被拼进 S3 访问配置，只用 hex：
#   openssl rand -hex 24
STORAGE_ROOT_USER=modelshot
STORAGE_ROOT_PASSWORD=请替换为openssl-rand-hex-24
# bucket 必须专供本项目使用，cleanup-orphans 会按前缀清理孤立对象。
STORAGE_BUCKET=modelshot-assets
S3_REGION=us-east-1

# ============ 对外访问地址 ============
# 浏览器实际访问的地址，决定登录回调、Cookie、支付回跳的 origin。
# 反代终止 TLS 时填 https://域名，不要带结尾斜杠，也不要填容器端口。
PUBLIC_URL=https://modelshot.example.com
# 部署在 Nginx / Caddy / 云负载均衡后面时设为 true，才会读取 X-Forwarded-* 头。
TRUST_PROXY=true
# 支付 webhook 需要独立域名时再填，留空则回落到 PUBLIC_URL。
WEBHOOK_URL=

# Web 容器发布端口。默认只绑 127.0.0.1，交给宿主机反代；
# 直接把 3000 暴露到公网（不推荐）时改成 BIND_ADDR=0.0.0.0。
BIND_ADDR=127.0.0.1
WEB_PORT=3000

# 镜像名与构建基础镜像。默认使用官方 Node 22 Debian slim。
MODELSHOT_IMAGE=modelshot:prod
# NODE_IMAGE=node:22.23.2-bookworm-slim

# ============ 应用密钥 ============
# 各自独立生成，不要复用同一个值：
#   openssl rand -hex 32
NEXTAUTH_SECRET=请替换为openssl-rand-hex-32
# 必须是 64 位小写 hex，长度不对 /api/ready 会直接失败：
#   openssl rand -hex 32
ENCRYPTION_KEY=请替换为openssl-rand-hex-32
ENCRYPTION_KEY_VERSION=1
# 轮换期间保留旧版本为 ENCRYPTION_KEY_<版本>、验证码密钥 ENCRYPTION_KEY_<版本>，
# 待 ops rotate-keys 完成并确认无旧凭据后再移除。
VERIFICATION_KEY_VERSION=1

# ============ 邮件（注册验码、通知）============
# 生产不要用本地 Mailpit 端口，需真实 SMTP。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ModelShot <no-reply@example.com>"

# ============ 登录第三方（可选）============
# 按需在 Google Cloud Console 配置回调：${PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============ 生成供应商（可选）============
# 不填则只能在管理后台配 BYOK 的供应商密钥；页面不会返回假图。
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
FASHN_API_KEY=

# ============ 支付（可选）============
# 未验收前保持 0，/api/checkout 会直接返回 503，不会误收款。
PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============ 运行参数 ============
# Worker 并发建议初始 2，上限 8；调整前先复测数据库连接、内存和供应商配额。
WORKER_CONCURRENCY=2
# 图片自动 QA 默认关闭，开启需要 OPENAI_API_KEY。
QA_ENABLED=0
# 平台级供应商代理白名单，逗号分隔的 HTTPS 主机名，留空表示不允许代理。
PROVIDER_PROXY_HOSTS=
# 发布镜像为无签名构建，必须保持 0，置 1 会被入口脚本拒绝启动。
C2PA_ENABLED=0
